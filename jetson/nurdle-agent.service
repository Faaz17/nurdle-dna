[Unit]
Description=NurdleDNA Jetson Agent (vision + cloud)
Documentation=https://github.com/Faaz17/nurdle-dna
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=faaz17
WorkingDirectory=/home/faaz17/nurdle-dna/jetson
# Wait for USB enumeration + force-load UVC camera driver before launching.
# Without this, the service can start before /dev/video0 binds to the webcam.
ExecStartPre=/bin/sleep 12
ExecStartPre=/bin/sh -c '/sbin/modprobe uvcvideo || true'
ExecStartPre=/bin/sh -c '/bin/udevadm settle --timeout=10 || true'
ExecStart=/usr/bin/python3 main.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/faaz17/nurdle-agent.log
StandardError=append:/home/faaz17/nurdle-agent.log

[Install]
WantedBy=multi-user.target
